# Database
MONGO_URI="mongodb://localhost:27017/your-db-name"

# JWT Secrets
JWT_ACCESS_SECRET="your-access-secret-here-minimum-32-characters"
JWT_REFRESH_SECRET="your-refresh-secret-here-minimum-32-characters"

# Server
PORT="8000"
NODE_ENV="development"

# Frontend
FRONTEND_BASE_URL="http://localhost:5173"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# Resend Email Service (for client onboarding forms & notifications)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Interview Scheduling (Cal.com)
# Backward-compatible global fallback booking URL (optional)
CALCOM_BOOKING_URL=""
# Optional template for fallback URLs. Supports placeholders:
# {applicationId} {jobId} {candidateEmail} {candidateName}
CALCOM_FALLBACK_BOOKING_URL_TEMPLATE=""
# Cal.com API configuration for dynamic per-job event sync
CALCOM_API_BASE_URL="https://api.cal.com"
CALCOM_API_TOKEN=""
CALCOM_API_VERSION="2024-06-14"
CALCOM_DEFAULT_ORGANIZER="HR Team"
CALCOM_WEBHOOK_SECRET=""
